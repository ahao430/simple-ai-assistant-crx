{
  "manifest_version": 3,
  "name": "简洁AI助手",
  "description": "Side panel AI assistant for page-aware chat and Yuque editing workflows.",
  "version": "0.2.1",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "clipboardRead", "clipboardWrite", "sidePanel", "scripting", "storage", "tabs"],
  "host_permissions": ["https://www.yuque.com/*", "<all_urls>"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/index.html",
  "action": {
    "default_title": "简洁AI助手",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/yuque.js"],
      "run_at": "document_idle"
    }
  ]
}
